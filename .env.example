# Public site URL (used for CORS Origin header on Google Drive resumable upload sessions and QR codes)
NEXT_SITE_URL=http://localhost:3000

# Google Apps Script web app URL for appending RSVP rows to a Google Sheet
RSVP_SHEET_WEBHOOK_URL=

# Google Drive OAuth 2.0 (couple's personal Google account, narrow drive.file scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=

# Shared secret embedded in table QR codes (/share?c=<UPLOAD_CODE>)
UPLOAD_CODE=change-me-to-a-long-random-secret

# Upload window in ISO-8601 with WAT (+01:00) offset (defaults: 5 Dec 2026 06:00 WAT to 12 Dec 2026 23:59 WAT)
UPLOADS_OPEN_AT=2026-12-05T06:00:00+01:00
UPLOADS_CLOSE_AT=2026-12-12T23:59:59+01:00

# Password protecting /admin/uploads and /share/qr
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional fallback Google Photos album URL shown when uploads are closed
FALLBACK_ALBUM_URL=

# Optional Upstash Redis for distributed rate limiting & gallery approval persistence
# Falls back to in-memory rate limiting and local JSON persistence if omitted
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=